{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Add new balloon",
      "type": "shell",
      "command": "npx ts-node tasks/add-balloon.ts ${input:balloonName}",
      "presentation": {
        "reveal": "always"
      }
    }
  ],
  "inputs": [
    {
      "id": "balloonName",
      "type": "promptString",
      "description": "Name of the balloon to add"
    }
  ]
}